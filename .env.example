# Copy this file to ".env" and fill in your own key(s).
#   cp .env.example .env

# Which LLM provider to use: deepseek or gemini
#   deepseek -> name generation + model-knowledge trademark (no live web search)
#   gemini   -> name generation + LIVE web-grounded trademark (Google Search)
PROVIDER=deepseek

# Required when PROVIDER=deepseek. Get one at: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# Valid ids: deepseek-chat (fast) or deepseek-reasoner
DEEPSEEK_MODEL=deepseek-chat

# Required when PROVIDER=gemini. Get one at: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional
PORT=3000
# A GitHub token raises the social-check rate limit (60/hr -> 5000/hr)
GITHUB_TOKEN=
